{
  "name": "barbermemo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm test && vite build && node scripts/upload-sourcemaps.mjs && node scripts/verify-billing-provider.mjs && node scripts/migrate-tenancy.mjs && node scripts/verify-billing-flow.mjs && node scripts/verify-provisioning.mjs && node scripts/verify-recovery.mjs",
    "lint": "oxlint",
    "preview": "vite preview",
    "test:monitoring": "node --test tests/monitoring.test.js",
    "monitoring:check": "node --env-file-if-exists=.env.monitoring.local scripts/monitoring.mjs check",
    "monitoring:test": "node --env-file-if-exists=.env.monitoring.local scripts/monitoring.mjs test",
    "monitoring:telegram": "node --env-file-if-exists=.env.monitoring.local scripts/monitoring.mjs telegram",
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "@sentry/node": "^11.12.0",
    "@sentry/react": "^11.12.0",
    "@supabase/supabase-js": "^2.110.5",
    "@vercel/functions": "^3.11.3",
    "browser-image-compression": "^2.0.2",
    "lucide-react": "^1.24.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@sentry/cli": "^3.8.2",
    "@tailwindcss/vite": "^4.3.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "pg": "^8.23.1",
    "tailwindcss": "^4.3.2",
    "vite": "^8.1.1"
  }
}
