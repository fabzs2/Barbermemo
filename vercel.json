{
  "routes": [
    {
      "src": "^/$",
      "dest": "/landing/index.html"
    },
    {
      "src": "/(?:login|redefinir-senha|dashboard|settings|admin|barbearia|metrics|clientes|agendamentos|agendar|api)(?:/.*)?$",
      "headers": {
        "X-Robots-Tag": "noindex, nofollow"
      },
      "continue": true
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/api/.*",
      "status": 404
    },
    {
      "src": "/.*",
      "dest": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/operations",
      "schedule": "0 8 * * *"
    }
  ],
  "functions": {
    "api/operations.js": {
      "maxDuration": 300,
      "includeFiles": [
        "scripts/certs/supabase-root.crt",
        "node_modules/@electric-sql/pglite/dist/**"
      ]
    }
  }
}
